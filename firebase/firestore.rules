rules_version = '2';
// Pravidla Firestore pro projekt azik-academy, sdílený weby 00, 01 a NAT-Academy (assets/ucet.js).
// Obsahuje beze změny bloky webů 00 (uzivatele) a 01 (uzivatele-eval) a nový blok pro BA Academy (uzivatele-nat).
// Každý přihlášený uživatel smí jen svůj dokument {uid} se třemi poli. Publikuje se ručně:
// Firebase konzole → Firestore → Rules → vložit CELÝ soubor → Publish (přepíše pravidla všech webů,
// proto musí obsahovat všechny tři bloky).
service cloud.firestore {
  match /databases/{database}/documents {
    // web 00: ISTQB CT-GenAI
    match /uzivatele/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['stav', 'casy', 'upraveno'])
                            && request.resource.data.stav is string
                            && request.resource.data.casy is string;
    }
    // web 01: Testování a evaluace LLM
    match /uzivatele-eval/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['stav', 'casy', 'upraveno'])
                            && request.resource.data.stav is string
                            && request.resource.data.casy is string;
    }
    // NAT-Academy: BA Academy
    match /uzivatele-nat/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['stav', 'casy', 'upraveno'])
                            && request.resource.data.stav is string
                            && request.resource.data.casy is string;
    }
  }
}
